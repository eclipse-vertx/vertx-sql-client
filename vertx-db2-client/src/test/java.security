#
# Minimal security properties override passed to the test JVM via
# -Djava.security.properties= (single '=', append/override mode).
#
# Sole purpose: allow TLS 1.1 so the DB2 test container can be reached.
# TLSv1 and TLSv1.1 are removed from the standard disabled-algorithms list;
# everything else is left at the JVM's built-in defaults.
# See https://bugs.openjdk.java.net/browse/JDK-8258598
#
jdk.tls.disabledAlgorithms=SSLv3, RC4, DES, MD5withRSA, \
    DH keySize < 1024, EC keySize < 224, 3DES_EDE_CBC, anon, NULL, \
    include jdk.disabled.namedCurves
